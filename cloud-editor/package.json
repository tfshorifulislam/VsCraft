{
  "name": "cloud-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless collaborative code editor backend monorepo",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @cloud-editor/api dev",
    "dev:realtime": "pnpm --filter @cloud-editor/realtime dev",
    "dev:runner": "pnpm --filter @cloud-editor/runner dev",
    "build": "pnpm -r build",
    "start:api": "pnpm --filter @cloud-editor/api start",
    "start:realtime": "pnpm --filter @cloud-editor/realtime start",
    "start:runner": "pnpm --filter @cloud-editor/runner start",
    "typecheck": "pnpm --filter @cloud-editor/shared build && pnpm -r typecheck",
    "db:migrate": "pnpm --filter @cloud-editor/api db:migrate",
    "db:migrate:prod": "pnpm --filter @cloud-editor/api db:migrate:prod"
  }
}
