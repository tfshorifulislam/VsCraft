# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
REALTIME_PORT=4001
RUNNER_PORT=4002

# ---------------------------------------------------------------------------
# Postgres
# Used by Docker Compose to initialize the dev database. The api container
# receives a DATABASE_URL pointing at the postgres service. For host tooling,
# replace "postgres" with "localhost".
# ---------------------------------------------------------------------------
POSTGRES_USER=cloud_editor
POSTGRES_PASSWORD=replace-me-with-a-strong-postgres-password
POSTGRES_DB=cloud_editor
DATABASE_URL=postgresql://cloud_editor:replace-me-with-a-strong-postgres-password@postgres:5432/cloud_editor

# ---------------------------------------------------------------------------
# Redis
# In production use the TLS URL supplied by Upstash/Redis Cloud, for example:
# rediss://default:password@host:6379
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# Auth (consumed by the API in a later prompt)
# Both secrets MUST be unique, random values of at least 32 characters.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me-with-a-random-access-token-secret-32chars-min
JWT_REFRESH_SECRET=replace-me-with-a-random-refresh-token-secret-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------------------------------------------------------------------------
# S3 / Cloudflare R2
# Dev uses MinIO. Production points at the R2 S3 endpoint and sets
# S3_FORCE_PATH_STYLE=false. For MinIO, S3_ACCESS_KEY is the root user and
# must be 3-20 characters; S3_SECRET_KEY must be at least 8 characters.
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=cloud-editor
S3_ACCESS_KEY=replace-minio-key
S3_SECRET_KEY=replace-minio-secret-key
S3_FORCE_PATH_STYLE=true
# Maximum size of a single file write. API requests are rejected above this.
MAX_FILE_SIZE_MB=2

# ---------------------------------------------------------------------------
# Runner
# ---------------------------------------------------------------------------
RUNNER_MAX_TIMEOUT_MS=30000
RUNNER_MAX_MEMORY_MB=256
RUNNER_MAX_CPU=0.5

# ---------------------------------------------------------------------------
# CORS
# Comma-separated origins are supported.
# ---------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000
