# CodeFigma realtime backend (WebSocket terminal only)
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Shared PostgreSQL database (same URL used by the Next.js app)
DATABASE_URL="postgresql://codefigma:codefigma@localhost:5432/codefigma?schema=public"

# Must match the Next.js JWT_SECRET exactly (used for WebSocket auth).
# Generate with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-random-32-plus-character-secret"

# Shell used for the PTY session (defaults to bash)
TERMINAL_SHELL=bash

# How often the ephemeral session directory is reconciled into the database
SYNC_INTERVAL_MS=2500

# Skip files larger than this when syncing terminal output to the database
MAX_SYNC_FILE_BYTES=1048576
