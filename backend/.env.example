# Backend Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/code_editor?schema=public"

# Authentication
JWT_SECRET="your-ultra-secure-jwt-secret-min-32-characters-long"

# WebSocket Terminal Server Port
TERMINAL_WS_PORT=3005

# Workspace Storage Directory (Defaults to backend/workspaces)
WORKSPACES_DIR="./workspaces"

# Optional AI Providers
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
ANTHROPIC_WORKSPACE_ID=""

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

