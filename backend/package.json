{
  "name": "codefigma-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime-only backend for CodeFigma (WebSocket terminal + editor sync)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.15.0",
    "@prisma/client": "6.4.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^6.2.13",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.24",
    "@types/ws": "^8.18.2",
    "prisma": "6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
