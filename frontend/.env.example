# PostgreSQL connection used by Prisma (server-side only)
DATABASE_URL="postgresql://codefigma:codefigma@localhost:5432/codefigma?schema=public"

# Shared secret with the realtime backend (HS256, 32+ characters in production)
JWT_SECRET="change-me-to-a-random-32-plus-character-secret"

# WebSocket endpoint of the realtime backend (must include the /terminal path)
NEXT_PUBLIC_TERMINAL_WS_URL=ws://localhost:4000/terminal
